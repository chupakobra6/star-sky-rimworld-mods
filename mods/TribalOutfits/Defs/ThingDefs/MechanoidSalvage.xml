<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>SSM_Tribal_MechSalvage</defName>
    <label>mechanoid salvage</label>
    <description>A piece of intact plating pried from a defeated mechanoid. It can be fitted into armor at a crafting spot or smithy.</description>
    <graphicData>
      <texPath>Things/Apparel/TribalOutfits/MechSalvage</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.75</Mass>
      <MarketValue>18</MarketValue>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <stackLimit>75</stackLimit>
  </ThingDef>

  <RecipeDef>
    <defName>SSM_Tribal_SalvageMechanoid</defName>
    <label>salvage mechanoid plating</label>
    <jobString>Prising salvage from a mechanoid.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>ButcheryMechanoidSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>ButcherMechanoid</effectWorking>
    <soundWorking>Recipe_SmashCorpseMechanoid</soundWorking>
    <ingredients>
      <li>
        <filter><categories><li>CorpsesMechanoid</li></categories></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter><categories><li>CorpsesMechanoid</li></categories></fixedIngredientFilter>
    <products><SSM_Tribal_MechSalvage>1</SSM_Tribal_MechSalvage></products>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
