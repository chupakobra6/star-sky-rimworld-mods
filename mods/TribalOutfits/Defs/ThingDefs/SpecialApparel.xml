  <ThingDef ParentName="SSM_Tribal_BarbarianApparel">
    <defName>SSM_Tribal_BarbarianCloak</defName>
    <label>barbarian cloak</label>
    <description>A heavy leather cloak that protects the torso and shoulders. It raises the wearer’s pain shock threshold.</description>
    <graphicData>
      <texPath>Things/Apparel/TribalOutfits/BarbarianCloak</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <costStuffCount>120</costStuffCount>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToMake>4500</WorkToMake>
      <Mass>1.5</Mass>
      <EquipDelay>2.5</EquipDelay>
      <StuffEffectMultiplierArmor>0.35</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.55</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.22</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <PainShockThreshold>0.10</PainShockThreshold>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>Things/Apparel/TribalOutfits/BarbarianCloak</wornGraphicPath>
    </apparel>
  </ThingDef>
