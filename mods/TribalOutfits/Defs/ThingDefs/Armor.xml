    <defName>SSM_Tribal_HiveHelmet</defName>
    <label>hive helmet</label>
    <description>Protective tribal apparel made from tough hides or insect chitin.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Things/Apparel/TribalOutfits/HiveHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>60</costStuffCount>
    <stuffCategories>
      <li>Leathery</li>
    </stuffCategories>
