      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/TribalOutfits/HiveHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
