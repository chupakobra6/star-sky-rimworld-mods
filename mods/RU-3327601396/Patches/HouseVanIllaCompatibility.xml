    <xpath>Defs/KCSG.SymbolDef[defName="DankPyon_Lootable_RackSword_BlocksMarble" and rotation="South"]/../KCSG.SymbolDef[defName="DankPyon_Lootable_RackSword_BlocksMarble" and rotation="West"]</xpath>
